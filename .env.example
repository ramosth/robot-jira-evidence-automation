# ---------------------------------------------------------------------------
# Copie para .env e preencha com os dados do SEU ambiente (o .env não é versionado).
# Usado apenas pelos scripts de integração com o Jira (libraries/integracao_jira).
# ---------------------------------------------------------------------------

# --- Jira Cloud ---
JIRA_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=seu.email@empresa.com
# Gere em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=seu_token_de_api
# Prefixo dos cards de caso de teste (ex.: QA -> QA-308)
PROJECT_KEY=QA

# --- Workflow ---
# Só cards neste status são movidos após a execução
STATUS_AUTOMACAO=Automation
# Transição aplicada quando o teste passa / falha
TRANSICAO_APROVADO=Ending
TRANSICAO_REPROVADO=Blocked

# --- Extrator de prints do log.html (os valores padrão já funcionam) ---
LOG_FILE_NAME=log.html
WINDOW_SIZE=1920,3000
EXPAND_DELAY=0.5
SCROLL_DELAY=0.3
PAGE_LOAD_DELAY=2
OUTPUT_DIR_NAME=prints_tests
SUCCESS_DIR_NAME=sucessos
FAILURE_DIR_NAME=falhas
